# ===== 网关部署配置 =====
# 服务器公网 IP（新加坡）
GATEWAY_HOST=YOUR_SINGAPORE_SERVER_IP
# CPA 对外端口
GATEWAY_PORT=8317
# 客户端访问 CPA 的主 Key（生成方法：openssl rand -hex 32）
MASTER_API_KEY=sk-orca-master-key-change-me
# CPA 管理接口/CPAMC 面板密码（openssl rand -hex 24）
CPA_ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET
# opencode2api 内网 server_key（CPA -> opencode2api 认证）
OC2API_SERVER_KEY=sk-oc2api-internal-change-me
# opencode2api WebUI 管理员用户名/密码（密码>=10字符）
OC2API_WEBUI_USER=admin
OC2API_WEBUI_PASSWORD=CHANGE_ME_MIN_10_CHARS
